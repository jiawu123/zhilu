# Server launch environment only; Node does not automatically load this file.
# In PowerShell set $env:NAME=... or launch Node 24 with --env-file explicitly.
ZHIHU_LIVE_ENABLED=false
# Absolute executable and cwd; fill your local paths, never commit personal .env.
ZHIHU_PYTHON_BIN=
ZHIHU_PYTHON_CWD=
ZHIHU_TIMEOUT_MS=630000

# M3 Roadmapper. These must be in the Node launch environment, not only packages/zhihu/.env.
# Priority: ROADMAP_* > LLM_* > official DeepSeek defaults; key also falls back to DEEPSEEK_API_KEY.
# API_URL is the COMPLETE chat-completions endpoint (not just a host or /v1 base URL).
# HTTPS required except HTTP loopback for a local compatible model. Redirects are not followed.
ROADMAP_API_URL=https://api.deepseek.com/chat/completions
ROADMAP_MODEL=deepseek-v4-pro
ROADMAP_API_KEY=
# Total wall-clock deadline, including reading the response; no automatic retry.
ROADMAP_TIMEOUT_MS=120000
# Output token budget for two 8–12-week routes; adjustable from 1 to 32768 within your model's limit.
ROADMAP_MAX_TOKENS=16384
# M3 planning allowance: min(confirmed weekly hours * percent / 100, hourly cap).
# Defaults: 10 percent, capped at 1 hour per full week; either 0 restores strict budgeting.
# Percentage range 0-50; hourly cap range 0-8. Partial weeks are prorated.
ROADMAP_WEEKLY_TOLERANCE_PERCENT=10
ROADMAP_WEEKLY_TOLERANCE_HOURS=1
# Optional shared fallbacks: LLM_API_URL, LLM_MODEL, LLM_API_KEY, DEEPSEEK_API_KEY.
# Never place API keys in VITE_* variables or commit personal .env files.
