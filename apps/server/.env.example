# Server launch environment only; Node does not automatically load this file.
# In PowerShell set $env:NAME=... or launch Node 24 with --env-file explicitly.
ZHIHU_LIVE_ENABLED=false
# Absolute executable and cwd; fill your local paths, never commit personal .env.
ZHIHU_PYTHON_BIN=
ZHIHU_PYTHON_CWD=
ZHIHU_TIMEOUT_MS=630000
