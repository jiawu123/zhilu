# Allow only application sources and deployment inputs into the build context.
**
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!tsconfig*.json
!apps/
!apps/**
!packages/
!packages/contracts/**
!packages/agent-runtime/**
!packages/plan-engine/**
!packages/zhihu/
!packages/zhihu/zhihu_m2/**
!packages/zhihu/requirements-dotenv.txt
!examples/
!examples/agent-engineer/
!examples/agent-engineer/plan-state.json
!deploy/
!deploy/cloudbase/**
!Dockerfile
**/node_modules
**/dist
**/.env*
**/__pycache__
**/*.test.*
**/*.log
**/.venv
**/data
**/artifacts
deploy/cloudbase/*.tar.gz
