# Set these in CloudBase server-side environment variables, never in frontend VITE_*.
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=
ZHIHU_OAUTH_REDIRECT_URI=
# Exact registered HTTPS URL ending in /api/auth/callback.

ROADMAP_API_URL=https://api.deepseek.com/chat/completions
ROADMAP_MODEL=
DEEPSEEK_API_KEY=
ZHIHU_LIVE_ENABLED=true
ZHIHU_ACCESS_SECRET=
# Headless Linux CLI uses ZHIHU_ACCESS_SECRET; desktop Keychain is not uploaded.
