# Loaded only by Python config.load_local_env(), UTF-8/BOM allowed, no interpolation.
# Existing process environment takes precedence. Never put secrets in VITE_*.
DEEPSEEK_API_KEY=
# Existing keychain authorization is separate from this optional CLI path.
ZHIHU_CLI_PATH=
ZHIHU_SEARCH_LIMIT_PER_QUERY=5
ZHIHU_COMPILER_MAX_CALLS=8
ZHIHU_RESEARCH_DEADLINE_SECONDS=600
# Local opt-in; restart the Server after changing its inherited environment.
ZHIHU_RETRIEVAL_PROFILE=legacy
